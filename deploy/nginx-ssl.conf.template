# HTTPS + iframe-embed whitelist config for webrtc-simple.
# setup-ssl.sh substitutes the DOMAIN / PARTNERS placeholders below and writes
# the result to /etc/nginx/nginx.conf, then reloads. (Placeholder tokens are
# intentionally NOT named in this comment so the substitution can't match here.)
#
# Loads the RTMP dynamic module; pinned to ONE worker so the published RTMP
# stream is visible to /stat and Kurento's pull (streams are not shared across
# nginx workers).
load_module modules/ngx_rtmp_module.so;
worker_processes 1;
# High fd limit + connections so a single worker survives viewer surges. Each
# viewer uses several conns (embed page + WS + keepalive); the OS default soft
# limit of 1024 fds exhausts fast under load → nginx 500s on plain static GETs
# ("too many open files"). MUST live in this template — setup-ssl.sh regenerates
# nginx.conf from here on every run, so any out-of-band tuning gets wiped.
worker_rlimit_nofile 65535;
events { worker_connections 16384; }

rtmp {
    server {
        listen 1935;
        chunk_size 4096;
        application live {
            live on;
            wait_key on;
            wait_video on;
            sync 10ms;
            allow publish all;
            allow play all;
        }
    }
}

http {
    # ---- iframe embed whitelist (referer gate) ----
    # $embed_ok = 1 only when the Referer (the iframe parent page) is a partner.
    # Empty referer (direct URL hit, curl) and any non-partner domain → 0 → 403.
    map $http_referer $embed_ok {
        default                 0;
__PARTNERS_REFERER__
    }

    # WebSocket UPGRADE requests carry an Origin header (the iframe parent), NOT
    # a Referer — so the referer map above 403s real iframe WS handshakes. This
    # parallel map gates /ws on Origin so partner iframes connect WITHOUT a token.
    # Same partner list, matched against $http_origin.
    #   "null"  → Telegram/iOS in-app webviews (and sandboxed iframes) send
    #             Origin: null. The PAGE that opened the WS was already partner-
    #             gated (referer map on /embed's parent + CSP frame-ancestors),
    #             so allowing null here lets Telegram/iOS embeds play without a
    #             token. (Token stays available for direct/testing access.)
    map $http_origin $origin_ok {
        default                 0;
        "null"                  1;
        # SELF-ORIGIN: the embed page runs ON this domain, so its WebSocket
        # handshake carries Origin: https://<this-domain> — NOT the partner's.
        # This is the common no-token case (Telegram/iOS/any browser loading the
        # embed): the page was already partner-gated (CSP frame-ancestors + the
        # referer map on the parent), and a same-origin WS is always legitimate.
        "https://__DOMAIN__"    1;
__PARTNERS_ORIGIN__
    }

    # ---- HTTP :80 → redirect to HTTPS (keep acme challenge for renew) ----
    server {
        listen 80;
        server_name __DOMAIN__;
        location ^~ /.well-known/acme-challenge/ { root /var/www/certbot; }
        location / { return 301 https://$host$request_uri; }
    }

    # ---- HTTPS :443 ----
    server {
        listen 443 ssl;
        server_name __DOMAIN__;

        ssl_certificate     /etc/letsencrypt/live/__DOMAIN__/fullchain.pem;
        ssl_certificate_key /etc/letsencrypt/live/__DOMAIN__/privkey.pem;
        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_ciphers HIGH:!aNULL:!MD5;

        root /var/www/webrtc-simple;
        index viewer.html;

        # Browser-enforced embed control: only these origins may frame us.
        add_header Content-Security-Policy "frame-ancestors __PARTNERS_CSP__;" always;

        # Plain viewer: partner-iframe only (referer gate). Serves the SAME page
        # as /embed — one viewer client, so the sound button and every future fix
        # land here too. (viewer.html is the bare debug page: native controls and
        # an ICE-state readout. It is not what a partner should ever show.)
        location = / {
            if ($embed_ok = 0) { return 403; }
            # Same page as /embed, so the same cache policy — see the note there.
            add_header Cache-Control "max-age=60, must-revalidate" always;
            try_files /embed.html =404;
        }

        # Token-gated embed page: served to anyone; access is enforced by the
        # token at the WS handshake (?lt=...), NOT by the referer whitelist.
        location = /embed {
            # Revalidate the viewer client, but let a reload be CHEAP.
            #
            # no-store was the first fix here, for a real trap: viewers held an
            # old player indefinitely and a deployed fix silently never reached
            # them (hours were lost debugging a page they had never loaded).
            # But no-store makes EVERY load a full transfer, and viewers reload
            # far more than they should (~7.9 loads/IP; see the 2026-07-16 plan,
            # Item 10) — so it made a thrash problem more expensive.
            #
            # max-age=60 + must-revalidate keeps both properties: a client can
            # never be more than a minute stale, and a reload inside that window
            # costs a 304 instead of a fresh 200.
            add_header Cache-Control "max-age=60, must-revalidate" always;
            try_files /embed.html =404;
        }

        # Static assets for the partner-gated viewer.
        location / {
            if ($embed_ok = 0) { return 403; }
            try_files $uri $uri/ =404;
        }

        # WebSocket signaling (WSS) → Node :3000. Allowed when ANY of: partner
        # Referer (plain viewer), partner Origin (real iframe WS handshake — the
        # common case, WS carries Origin not Referer), OR an ?lt= token (embed).
        # Node validates the token; bad tokens are rejected there.
        location /ws {
            set $ws_block 1;
            if ($embed_ok = 1)   { set $ws_block 0; }
            if ($origin_ok = 1)  { set $ws_block 0; }
            if ($arg_lt != "")   { set $ws_block 0; }
            if ($ws_block = 1) { return 403; }
            proxy_pass http://127.0.0.1:3000;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
            proxy_set_header Host $host;
            proxy_read_timeout 3600s;
        }

        # RTMP stat — localhost only, for debugging (not partner-gated).
        location /stat {
            allow 127.0.0.1;
            deny all;
            rtmp_stat all;
        }
    }
}
